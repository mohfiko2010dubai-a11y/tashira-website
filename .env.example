# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
CUSTOMER_SESSION_SECRET=  # HMAC secret for customer-owned application capability cookies (32+ characters)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# Stripe mode must be explicit and all three credentials must belong to it.
STRIPE_MODE=              # TEST or LIVE
STRIPE_SECRET_KEY=        # Stripe secret key matching STRIPE_MODE (sk_test_... or sk_live_...)
STRIPE_WEBHOOK_SECRET=    # Stripe webhook signing secret (whsec_...)
VITE_STRIPE_PUBLISHABLE_KEY= # Matching publishable key (pk_test_... or pk_live_...)

# Transactional email (disabled unless EMAIL_MODE=resend; production also requires explicit enablement)
EMAIL_MODE=                 # Set to resend only in an approved environment
ENABLE_PRODUCTION_EMAIL=   # Must be true before real-customer production delivery is allowed
RESEND_API_KEY=            # Secret Resend API key; never expose through VITE_ variables
FROM_NAME=                 # Transactional sender display name
FROM_EMAIL=                # Sender on a Resend-verified domain
PUBLIC_APP_URL=            # Public origin used for safe tracking/resume actions
STAGING_EMAIL_ALLOWED_RECIPIENTS= # Comma-separated staging-only recipient allowlist

# Browser-visible Google measurement configuration (IDs only; never customer/document data)
VITE_GOOGLE_TAG_ID=G-650XVXCSYB # Production GA4 measurement ID (public, not a secret)
