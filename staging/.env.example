# Public, non-secret staging settings only.
STAGING_HOSTNAME=staging.tashiraev.com
STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443
STAGING_DATABASE_NAME=tashira_staging
STAGING_DATABASE_USER=tashira_staging_app

# Browser-visible TEST key. Never use a pk_live_ key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STAGING_KEY

# Optional public application identifiers.
VITE_APP_ID=staging
VITE_KIMI_AUTH_URL=https://unused.example.com
